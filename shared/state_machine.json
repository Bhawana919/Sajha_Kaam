{
  "version": 1,
  "card": {
    "initial": "draft",
    "locked_from": "worker_accepted",
    "states": [
      "draft",
      "ai_drafted",
      "client_edited",
      "rules_failed",
      "rules_passed",
      "pending_review",
      "approved",
      "open",
      "expired",
      "closed_for_applications",
      "in_review",
      "picked",
      "revealed",
      "worker_declined",
      "worker_accepted",
      "in_progress",
      "delivered",
      "revision_requested",
      "client_confirmed",
      "payment_handoff",
      "completed",
      "passport_issued",
      "disputed",
      "cancelled"
    ],
    "transitions": [
      { "from": "draft", "to": "ai_drafted", "action": "draft_with_ai", "actor": "client" },
      { "from": "draft", "to": "client_edited", "action": "edit", "actor": "client" },
      { "from": "ai_drafted", "to": "client_edited", "action": "edit", "actor": "client" },
      { "from": "client_edited", "to": "client_edited", "action": "edit", "actor": "client" },
      { "from": "ai_drafted", "to": "rules_passed", "action": "check_rules", "actor": "system" },
      { "from": "ai_drafted", "to": "rules_failed", "action": "check_rules", "actor": "system" },
      { "from": "client_edited", "to": "rules_passed", "action": "check_rules", "actor": "system" },
      { "from": "client_edited", "to": "rules_failed", "action": "check_rules", "actor": "system" },
      { "from": "rules_failed", "to": "client_edited", "action": "edit", "actor": "client" },
      { "from": "rules_passed", "to": "client_edited", "action": "edit", "actor": "client" },
      { "from": "rules_passed", "to": "pending_review", "action": "post", "actor": "client", "note": "first card or flagged card" },
      { "from": "rules_passed", "to": "open", "action": "post", "actor": "client" },
      { "from": "pending_review", "to": "approved", "action": "approve", "actor": "admin" },
      { "from": "pending_review", "to": "client_edited", "action": "request_change", "actor": "admin" },
      { "from": "pending_review", "to": "cancelled", "action": "reject", "actor": "admin" },
      { "from": "approved", "to": "open", "action": "open_window", "actor": "system" },
      { "from": "open", "to": "expired", "action": "expire", "actor": "system", "note": "window closed with no applicants" },
      { "from": "expired", "to": "open", "action": "extend", "actor": "client", "note": "once, by 48 h" },
      { "from": "open", "to": "closed_for_applications", "action": "close_window", "actor": "system", "note": "48 h passed or 15 applicants" },
      { "from": "closed_for_applications", "to": "in_review", "action": "start_review", "actor": "client" },
      { "from": "in_review", "to": "picked", "action": "pick", "actor": "client", "note": "requires not-acquainted attestation" },
      { "from": "picked", "to": "revealed", "action": "reveal", "actor": "client" },
      { "from": "revealed", "to": "worker_accepted", "action": "accept", "actor": "worker", "note": "requires Khalti payment link; locks terms" },
      { "from": "revealed", "to": "worker_declined", "action": "decline", "actor": "worker", "note": "no penalty" },
      { "from": "worker_declined", "to": "picked", "action": "offer_next", "actor": "system", "note": "next-highest score" },
      { "from": "worker_accepted", "to": "in_progress", "action": "start_work", "actor": "system" },
      { "from": "in_progress", "to": "delivered", "action": "deliver", "actor": "worker" },
      { "from": "delivered", "to": "revision_requested", "action": "request_revision", "actor": "client", "note": "only while revisions remain" },
      { "from": "revision_requested", "to": "delivered", "action": "deliver", "actor": "worker" },
      { "from": "delivered", "to": "client_confirmed", "action": "confirm", "actor": "client", "note": "every checklist item met" },
      { "from": "client_confirmed", "to": "payment_handoff", "action": "client_paid", "actor": "client" },
      { "from": "payment_handoff", "to": "completed", "action": "worker_received", "actor": "worker" },
      { "from": "completed", "to": "passport_issued", "action": "issue_passport", "actor": "system" },
      { "from": "*locked", "to": "disputed", "action": "open_case", "actor": "any_party" },
      { "from": "disputed", "to": "*previous", "action": "resolve", "actor": "admin" },
      { "from": "disputed", "to": "cancelled", "action": "cancel", "actor": "admin" }
    ]
  },
  "application": {
    "initial": "submitted",
    "states": ["submitted", "withdrawn", "scored", "picked", "not_picked_feedback_sent"],
    "transitions": [
      { "from": "submitted", "to": "withdrawn", "action": "withdraw", "actor": "worker", "note": "only before the pick" },
      { "from": "submitted", "to": "scored", "action": "score", "actor": "client" },
      { "from": "scored", "to": "scored", "action": "score", "actor": "client" },
      { "from": "scored", "to": "picked", "action": "pick", "actor": "client" },
      { "from": "scored", "to": "not_picked_feedback_sent", "action": "send_feedback", "actor": "system" },
      { "from": "submitted", "to": "not_picked_feedback_sent", "action": "send_feedback", "actor": "system" }
    ]
  }
}
